// Title: Non-Browser Access to Chromium Credential Stores Followed by Network Activity
//
// Classification:
// Accepted — Hunting Query
//
// Description:
// Hunts for non-browser processes accessing Chromium credential stores (Cookies or Login Data)
// and then performing outbound network activity from the same process on the same device within
// five minutes. This behavior can support investigation of infostealer-driven browser credential
// or authenticated-session theft.
//
// This is intentionally a hunting query, not a production detection rule.
//
// Source:
// Hackers Steal Claude Login Sessions With Infostealer Malware to Hijack Accounts
// https://cybersecuritynews.com/hackers-steal-claude-login-sessions/
//
// MITRE ATT&CK:
// T1555.003 - Credentials from Web Browsers
// T1539     - Steal Web Session Cookie
//
// Investigation guidance:
// - Validate the initiating process, signer, path, hash, and parent process.
// - Determine whether the process is legitimate browser-management, security, backup, or support software.
// - Review the accessed browser profile and whether Cookies or Login Data were touched.
// - Review the remote destination, network timing, and any subsequent archive/staging activity.
// - Pivot to additional file/process/network activity from the same process and device.
// - Treat the result as a hunting lead; legitimate software can access browser profile data.
//
// Validation notes:
// In the reviewed 30-day telemetry, non-browser access to broader Chromium profile artifacts was present
// and attributable to legitimate software. When narrowed to Cookies or Login Data followed by network
// activity from the same process within five minutes, the validation query returned zero results.

let Lookback = 30d;

let CredentialStoreAccess =
    DeviceFileEvents
    | where Timestamp >= ago(Lookback)
    | where FileName in~ ("Cookies", "Login Data")
    | where FolderPath has_any (
        @"\Google\Chrome\User Data\",
        @"\Microsoft\Edge\User Data\",
        @"\BraveSoftware\Brave-Browser\User Data\"
    )
    | where isnotempty(InitiatingProcessFileName)
    | where InitiatingProcessFileName !in~ (
        "chrome.exe",
        "msedge.exe",
        "brave.exe",
        "msedgewebview2.exe"
    )
    | project
        DeviceId,
        AccessTime = Timestamp,
        AccessedFile = FileName,
        AccessedPath = FolderPath,
        ProcessName = InitiatingProcessFileName,
        ProcessPath = InitiatingProcessFolderPath,
        ProcessCommandLine = InitiatingProcessCommandLine,
        ProcessSHA256 = InitiatingProcessSHA256,
        ParentProcess = InitiatingProcessParentFileName;

let NetworkActivity =
    DeviceNetworkEvents
    | where Timestamp >= ago(Lookback)
    | where isnotempty(InitiatingProcessFileName)
    | project
        DeviceId,
        NetworkTime = Timestamp,
        NetworkProcess = InitiatingProcessFileName,
        NetworkProcessSHA256 = InitiatingProcessSHA256,
        RemoteUrl,
        RemoteIP,
        RemotePort,
        ActionType;

CredentialStoreAccess
| join kind=inner NetworkActivity on DeviceId
| where NetworkTime >= AccessTime
| where NetworkTime <= AccessTime + 5m
| where NetworkProcess =~ ProcessName
| where isempty(ProcessSHA256)
    or isempty(NetworkProcessSHA256)
    or NetworkProcessSHA256 == ProcessSHA256
| project
    AccessTime,
    NetworkTime,
    DeviceId,
    ProcessName,
    ProcessPath,
    ProcessCommandLine,
    ParentProcess,
    AccessedFile,
    AccessedPath,
    RemoteUrl,
    RemoteIP,
    RemotePort,
    ActionType
| order by AccessTime desc
