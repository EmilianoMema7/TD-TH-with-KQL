// Title: Banana RAT Script Execution From Randomized ProgramData Microsoft Path
//
// Description:
// Hunt for Banana RAT-like execution and staging behavior using randomized
// ProgramData\Microsoft directories. The detection focuses on script, Node.js,
// and conhost execution from suspicious randomized Microsoft-looking paths,
// rather than generic scheduled task persistence.
//
// Detection logic focuses on:
// - Script execution from C:\ProgramData\Microsoft\<random hex-like folder>\
// - Node.js or conhost execution from the same randomized path
// - VBS, PowerShell, JavaScript, DAT, or text artifacts staged in that path
//
// Source:
// https://any.run/cybersecurity-blog/banana-rat-evolution-analysis/
//
// MITRE ATT&CK:
// T1059.001 - Command and Scripting Interpreter: PowerShell
// T1059.005 - Command and Scripting Interpreter: Visual Basic
// T1059.007 - Command and Scripting Interpreter: JavaScript
// T1036     - Masquerading
// T1105     - Ingress Tool Transfer
// T1204.002 - User Execution: Malicious File
//
// Expected Result:
// Very low. The rebuilt query returned 0 results during telemetry validation.
//
// False Positive Notes:
// - Legitimate software may create folders under ProgramData\Microsoft, but randomized hex-like
//   folders containing script artifacts and execution via wscript, cscript, PowerShell, Node.js,
//   or conhost should be uncommon.
// - Investigate the staged files, signer, hash reputation, parent process, scheduled tasks,
//   and any outbound network activity from the same device.
// - Avoid adding proactive exclusions unless specific false-positive patterns are observed.

let Lookback = 30d;

let BananaRatRandomProgramDataPath = @".*\\ProgramData\\Microsoft\\[a-fA-F0-9]{12,}\\.*";

let BananaRatScriptExecution =
DeviceProcessEvents
| where Timestamp >= ago(Lookback)
| where FileName in~ ("wscript.exe", "cscript.exe", "powershell.exe", "pwsh.exe")
| where ProcessCommandLine matches regex BananaRatRandomProgramDataPath
| where ProcessCommandLine has_any (
    ".vbs",
    ".ps1",
    ".txt",
    "-WindowStyle Hidden",
    "-W Hidden",
    "-NoP",
    "-EP Bypass"
)
| extend DetectionType = "Banana RAT-like script execution from randomized ProgramData Microsoft path"
| project
    Timestamp,
    DeviceName,
    AccountName,
    DetectionType,
    FileName,
    FolderPath,
    ProcessCommandLine,
    InitiatingProcessFileName,
    InitiatingProcessCommandLine,
    SHA256;

let BananaRatNodeExecution =
DeviceProcessEvents
| where Timestamp >= ago(Lookback)
| where FileName in~ ("node.exe", "conhost.exe")
| where ProcessCommandLine matches regex BananaRatRandomProgramDataPath
| where ProcessCommandLine has_any (
    ".js",
    ".dat",
    "--headless",
    "-WindowStyle Hidden",
    "-W Hidden"
)
| extend DetectionType = "Banana RAT-like Node or conhost execution from randomized ProgramData Microsoft path"
| project
    Timestamp,
    DeviceName,
    AccountName,
    DetectionType,
    FileName,
    FolderPath,
    ProcessCommandLine,
    InitiatingProcessFileName,
    InitiatingProcessCommandLine,
    SHA256;

let BananaRatFileArtifacts =
DeviceFileEvents
| where Timestamp >= ago(Lookback)
| where FolderPath matches regex BananaRatRandomProgramDataPath
| where FileName endswith ".vbs"
    or FileName endswith ".ps1"
    or FileName endswith ".txt"
    or FileName endswith ".js"
    or FileName endswith ".dat"
| extend DetectionType = "Banana RAT-like script artifact in randomized ProgramData Microsoft path"
| project
    Timestamp,
    DeviceName,
    AccountName = InitiatingProcessAccountName,
    DetectionType,
    FileName,
    FolderPath,
    ProcessCommandLine = InitiatingProcessCommandLine,
    InitiatingProcessFileName,
    InitiatingProcessCommandLine,
    SHA256;

union
BananaRatScriptExecution,
BananaRatNodeExecution,
BananaRatFileArtifacts
| sort by Timestamp desc
